  <diagram id="K1GxIqSvRbibxhD_sm8U" name="flow chi tiết combat">
    <mxGraphModel dx="1768" dy="1036" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    CombatInit[\&quot;CombatUseCase.StartCombat()&lt;br/&gt;enemyId → Create Enemy\&quot;]\n    CombatInit --&gt; CreateSession[\&quot;CombatSession(player, enemy)&lt;br/&gt;Round = 1, Turn = Player\&quot;]\n    \n    CreateSession --&gt; CombatLoop[\&quot;⚔️ Combat Loop\&quot;]\n    \n    CombatLoop --&gt; PlayerTurn{Current Turn?}\n    \n    PlayerTurn --&gt;|Player| PlayerChoice[\&quot;Player Turn Options:&lt;br/&gt;1. Attack&lt;br/&gt;2. Use Item&lt;br/&gt;3. Flee\&quot;]\n    \n    PlayerChoice --&gt;|Attack| ExecuteAttack[\&quot;CombatSession.Execute(&lt;br/&gt;AttackCommand)\&quot;]\n    PlayerChoice --&gt;|Use Item| ExecuteItem[\&quot;CombatSession.Execute(&lt;br/&gt;UseItemCommand)\&quot;]\n    PlayerChoice --&gt;|Flee| ExecuteFlee[\&quot;CombatSession.Execute(&lt;br/&gt;FleeCommand)\&quot;]\n    \n    ExecuteAttack --&gt; CalcDamage[\&quot;DamageCalculator.Calculate()&lt;br/&gt;base_dmg = attack - enemy.def&lt;br/&gt;Apply crit chance\&quot;]\n    CalcDamage --&gt; DealDamage[\&quot;Enemy.TakeDamage(dmg)&lt;br/&gt;Enemy.Health -= dmg\&quot;]\n    \n    ExecuteItem --&gt; ItemApply[\&quot;ApplyItemEffect()&lt;br/&gt;Restore HP or Buff\&quot;]\n    \n    ExecuteFlee --&gt; FleeCheck{Flee Success?}\n    FleeCheck --&gt;|Success| FleeWin[\&quot;Combat.Fled = true&lt;br/&gt;Combat.IsFinished = true&lt;br/&gt;No loot\&quot;]\n    FleeCheck --&gt;|Fail| CombatLoop\n    \n    DealDamage --&gt; CheckEnemyDead{Enemy Dead?}\n    ItemApply --&gt; CombatLoop\n    \n    CheckEnemyDead --&gt;|No| EnemyTurn[\&quot;Enemy AI Turn&lt;br/&gt;IEnemyAI.DecideAction()\&quot;]\n    CheckEnemyDead --&gt;|Yes| PlayerWins[\&quot;✅ Player Wins&lt;br/&gt;Combat.IsFinished = true\&quot;]\n    \n    EnemyTurn --&gt; EnemyAction{AI Decision}\n    EnemyAction --&gt;|Attack| EnemyAttack[\&quot;EnemyCommand.Execute()&lt;br/&gt;Damage = enemy.attack - player.def\&quot;]\n    EnemyAction --&gt;|Skill| EnemySkill[\&quot;Skill command&lt;br/&gt;Depends on phase\&quot;]\n    \n    EnemyAttack --&gt; PlayerTakeDamage[\&quot;Player.TakeDamage(dmg)&lt;br/&gt;Player.Health -= dmg\&quot;]\n    EnemySkill --&gt; PlayerTakeDamage\n    \n    PlayerTakeDamage --&gt; CheckPlayerDead{Player Dead?}\n    CheckPlayerDead --&gt;|No| RoundEnd[\&quot;Round++&lt;br/&gt;Turn = Player\&quot;]\n    CheckPlayerDead --&gt;|Yes| PlayerDies[\&quot;❌ Player Dies&lt;br/&gt;Combat.IsFinished = true\&quot;]\n    \n    RoundEnd --&gt; CombatLoop\n    \n    FleeWin --&gt; CombatFinish[\&quot;CombatUseCase.ExecuteCommand()&lt;br/&gt;Process Events\&quot;]\n    PlayerWins --&gt; CombatFinish\n    PlayerDies --&gt; CombatFinish\n    \n    CombatFinish --&gt; CombatEnd{Combat Result?}\n    CombatEnd --&gt;|Fled| NoLoot[\&quot;session.ActiveCombatSession = null&lt;br/&gt;Return to Gameplay\&quot;]\n    CombatEnd --&gt;|Player Dies| GameOverFlow[\&quot;Game Over\&quot;]\n    CombatEnd --&gt;|Player Wins| ApplyBossReward{Is Boss?}\n    \n    ApplyBossReward --&gt;|Yes| BossReward[\&quot;ApplyBossRewards()&lt;br/&gt;High loot + Diff++\&quot;]\n    ApplyBossReward --&gt;|No| NormalLoot[\&quot;ApplyLoot()&lt;br/&gt;Standard enemy loot\&quot;]\n    \n    BossReward --&gt; CombatDone[\&quot;Return to Gameplay\&quot;]\n    NormalLoot --&gt; CombatDone\n    NoLoot --&gt; Done([Combat Over])\n    CombatDone --&gt; Done\n    GameOverFlow --&gt; Done\n    \n    style CombatInit fill:#FF7F50\n    style PlayerWins fill:#90EE90\n    style PlayerDies fill:#FFB6C6\n    style FleeWin fill:#FFD700\n    style CalcDamage fill:#87CEEB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2mrGjcF9st33soOZr98v-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="CombatUseCase.StartCombat()&#xa;enemyId → Create Enemy" mermaidId="n:CombatInit" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#FF7F50;strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="CombatUseCase.StartCombat()&#xa;enemyId → Create Enemy" id="2mrGjcF9st33soOZr98v-2">
