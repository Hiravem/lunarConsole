  <diagram id="3v2IC0FC6uTFrXLV0Kdm" name="flow chi tiết Daily cycle">
    <mxGraphModel dx="1664" dy="975" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    DayStart[\&quot;📅 Day {N} Begins&lt;br/&gt;DayFlags.Reset()\&quot;]\n    \n    DayStart --&gt; CheckBoss{Is Boss Day?}\n    CheckBoss --&gt;|Yes| BossOnly[\&quot;Only option: Fight Boss&lt;br/&gt;Explore/Rest disabled\&quot;]\n    CheckBoss --&gt;|No| DailyMenu[\&quot;Daily Menu&lt;br/&gt;Explore | Rest | Inventory\&quot;]\n    \n    BossOnly --&gt; FightBoss[\&quot;BossBattleUseCase&lt;br/&gt;Start Combat\&quot;]\n    \n    DailyMenu --&gt; ActionChoice{Player Chooses?}\n    \n    ActionChoice --&gt;|Explore| ExploreAction[\&quot;✓ HasExplored = true&lt;br/&gt;EncounterTable.PickRandom()&lt;br/&gt;ExploreResolver.Resolve()\&quot;]\n    \n    ActionChoice --&gt;|Rest| RestAction[\&quot;✓ HasRested = true&lt;br/&gt;RestUseCase.Execute()&lt;br/&gt;Restore 30% MaxHP\&quot;]\n    \n    ActionChoice --&gt;|Inventory| InvAction[\&quot;⭘ Inventory Management&lt;br/&gt;Equip/Unequip items&lt;br/&gt;No HasUsedDayAction flag\&quot;]\n    \n    ActionChoice --&gt;|Equipment| EqAction[\&quot;⭘ Equipment Management&lt;br/&gt;Change loadout&lt;br/&gt;No HasUsedDayAction flag\&quot;]\n    \n    ExploreAction --&gt; ExploreOutcome{Outcome?}\n    ExploreOutcome --&gt;|Combat| CombatEncounter[\&quot;StartCombat&lt;br/&gt;ExecuteCommand loop\&quot;]\n    ExploreOutcome --&gt;|Loot| LootGain[\&quot;ApplyLoot&lt;br/&gt;Add to inventory\&quot;]\n    ExploreOutcome --&gt;|Event| EventEffect[\&quot;Apply gold/HP/damage\&quot;]\n    ExploreOutcome --&gt;|Merchant| MerchantTrade[\&quot;Open merchant&lt;br/&gt;Buy/Sell\&quot;]\n    \n    RestAction --&gt; CheckActionUsed1{HasUsedDayAction?}\n    CheckActionUsed1 --&gt;|Yes| DailyMenu\n    CheckActionUsed1 --&gt;|No| DailyMenu\n    \n    InvAction --&gt; DailyMenu\n    EqAction --&gt; DailyMenu\n    CombatEncounter --&gt; CombatEnd{Combat Over?}\n    CombatEnd --&gt;|Fled or Won| DailyMenu\n    CombatEnd --&gt;|Player Dies| GameOverDay[\&quot;Game Over\&quot;]\n    \n    LootGain --&gt; DailyMenu\n    EventEffect --&gt; DailyMenu\n    MerchantTrade --&gt; DailyMenu\n    \n    BossOnly --&gt; BossCombatDay[\&quot;BossCombat: Multi-phase\&quot;]\n    BossCombatDay --&gt; BossOutcome{Boss Over?}\n    BossOutcome --&gt;|Player Dies| GameOverDay\n    BossOutcome --&gt;|Boss Defeated| BossRewardDay[\&quot;Reward + Difficulty++&lt;br/&gt;Day = 1 (Reset)\&quot;]\n    BossRewardDay --&gt; DayStart\n    \n    FightBoss --&gt; BossCombatDay\n    \n    DailyMenu --&gt; CanAdvance{Ready to Advance?}\n    CanAdvance --&gt;|No, need action| DailyMenu\n    CanAdvance --&gt;|No, boss alive| DailyMenu\n    CanAdvance --&gt;|Yes| AdvanceDay[\&quot;AdvanceDayUseCase&lt;br/&gt;CurrentDay++&lt;br/&gt;Check: Day % 5 = 0 → BossDay\&quot;]\n    \n    AdvanceDay --&gt; DayStart\n    GameOverDay --&gt; End([End])\n    \n    style DayStart fill:#FFE4B5\n    style AdvanceDay fill:#98FB98\n    style GameOverDay fill:#FFB6C6\n    style InvAction fill:#DDA0DD\n    style EqAction fill:#DDA0DD&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1Yu7lKYjPgrxFV6S8Oy6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="📅 Day {N} Begins&#xa;DayFlags.Reset()" mermaidId="n:DayStart" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#FFE4B5;strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="📅 Day {N} Begins&#xa;DayFlags.Reset()" id="1Yu7lKYjPgrxFV6S8Oy6-2">
          <mxCell parent="1Yu7lKYjPgrxFV6S8Oy6-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#FFE4B5;strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="189" x="2089" y="40" as="geometry" />
          </mxCell>
