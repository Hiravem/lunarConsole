  <diagram id="orhuXMeXCCRarAhl0LSn" name="flow chi tiết Boss">
    <mxGraphModel dx="1664" dy="975" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    BossCheck[\&quot;CurrentDay % BossIntervalDays = 0&lt;br/&gt;AdvanceDayUseCase sets IsBossDay = true\&quot;]\n    \n    BossCheck --&gt; BossDay[\&quot;Day {N} — Boss Day!&lt;br/&gt;Message: &#39;The boss awaits!&#39;&lt;br/&gt;No Explore/Rest allowed\&quot;]\n    \n    BossDay --&gt; BossMenu[\&quot;🎮 Boss Day Menu&lt;br/&gt;Only: Fight Boss | Inventory\&quot;]\n    \n    BossMenu --&gt; FightChoice{Player Chooses?}\n    FightChoice --&gt;|Inventory| InvBoss[\&quot;Inventory access&lt;br/&gt;Return to menu\&quot;]\n    FightChoice --&gt;|Fight Boss| StartBoss[\&quot;BossBattleUseCase.StartBossFight()\&quot;]\n    InvBoss --&gt; BossMenu\n    \n    StartBoss --&gt; Check1{Already in combat?}\n    Check1 --&gt;|Yes| FailCombat[\&quot;Fail: &#39;Already in combat&#39;\&quot;]\n    Check1 --&gt;|No| Check2{Is boss day?}\n    \n    FailCombat --&gt; BossMenu\n    Check2 --&gt;|No| FailDay[\&quot;Fail: &#39;No boss on this day&#39;\&quot;]\n    Check2 --&gt;|Yes| CreateBoss[\&quot;BossFactory.Create(bossId, difficulty)&lt;br/&gt;bossId = &#39;skeleton_king&#39;\&quot;]\n    \n    FailDay --&gt; BossMenu\n    \n    CreateBoss --&gt; InitCombat[\&quot;CombatSession(player, boss)&lt;br/&gt;Boss has Phases\&quot;]\n    \n    InitCombat --&gt; BossCombat[\&quot;⚔️ Multi-phase Combat\&quot;]\n    \n    BossCombat --&gt; CombatLoop[\&quot;Execute Combat&lt;br/&gt;(see Combat Flow diagram)\&quot;]\n    \n    CombatLoop --&gt; BossTurn{Boss HP&lt;br/&gt;at threshold?}\n    BossTurn --&gt;|Yes| NextPhase[\&quot;Trigger next IBossPhase&lt;br/&gt;Boss.CurrentPhase++&lt;br/&gt;Reset abilities/HP%\&quot;]\n    BossTurn --&gt;|No| CombatLoop\n    NextPhase --&gt; CombatLoop\n    \n    CombatLoop --&gt; CombatEnd{Combat Over?}\n    \n    CombatEnd --&gt;|Player Died| BossFail[\&quot;❌ Player Defeated&lt;br/&gt;Game Over\&quot;]\n    CombatEnd --&gt;|Boss Defeated| BossWin[\&quot;✅ Boss Defeated!\&quot;]\n    CombatEnd --&gt;|Fled| BossCannotFlee[\&quot;Cannot flee from boss&lt;br/&gt;(Flee command fails)\&quot;]\n    \n    BossCannotFlee --&gt; CombatLoop\n    \n    BossFail --&gt; EndBossFail([Game Over])\n    \n    BossWin --&gt; ApplyReward[\&quot;ApplyBossRewards(session, boss)&lt;br/&gt;ApplyLoot(loot_table)&lt;br/&gt;Difficulty++&lt;br/&gt;CurrentDay = 1&lt;br/&gt;IsBossDay = false&lt;br/&gt;DayFlags.Reset()\&quot;]\n    \n    ApplyReward --&gt; RewardMsg[\&quot;Message: &#39;Boss defeated!&lt;br/&gt;Loot obtained: XXX&lt;br/&gt;Difficulty increased to N&lt;br/&gt;New cycle begins.&#39;\&quot;]\n    \n    RewardMsg --&gt; MetaUpdate[\&quot;MetaProgression.OnBossDefeated(difficulty)&lt;br/&gt;Track high scores\&quot;]\n    \n    MetaUpdate --&gt; BackToGame[\&quot;Return to Gameplay&lt;br/&gt;(New Daily Cycle on Day 1)\&quot;]\n    \n    BackToGame --&gt; End([Resume Game])\n    \n    style BossDay fill:#FF6347\n    style BossCombat fill:#FF7F50\n    style BossWin fill:#90EE90\n    style BossFail fill:#FFB6C6\n    style NextPhase fill:#FFD700\n    style ApplyReward fill:#98FB98&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CJEuZx2TkTi3gAOyMf5M-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
