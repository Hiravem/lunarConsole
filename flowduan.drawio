  <diagram id="-xSV5sAz1PP0oDQ0KRCT" name="flow chi tiết Encounter &amp; Loot System">
    <mxGraphModel dx="2357" dy="1382" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    ExploreStart[\&quot;ExploreUseCase.Execute()\&quot;]\n    \n    ExploreStart --&gt; CheckBossDay{Is Boss Day?}\n    CheckBossDay --&gt;|Yes| FailBoss[\&quot;Fail: &#39;Boss day,&lt;br/&gt;face boss instead&#39;\&quot;]\n    CheckBossDay --&gt;|No| CheckAction{HasUsedDayAction?}\n    \n    CheckAction --&gt;|Yes| FailAction[\&quot;Fail: &#39;Already used&lt;br/&gt;main action&#39;\&quot;]\n    CheckAction --&gt;|No| PickEncounter[\&quot;EncounterTable.PickRandom()&lt;br/&gt;random by Difficulty&lt;br/&gt;Weighted selection\&quot;]\n    \n    FailBoss --&gt; End1([Return Fail])\n    FailAction --&gt; End1\n    \n    PickEncounter --&gt; Encounter{Encounter Type?}\n    \n    Encounter --&gt;|CombatEncounter| CombatExec[\&quot;ExploreResolver.Resolve()&lt;br/&gt;Create Enemy&lt;br/&gt;StartCombat\&quot;]\n    Encounter --&gt;|LootChest| LootChest[\&quot;ExploreResolver.Resolve()&lt;br/&gt;EncounterResult.LootTableId\&quot;]\n    Encounter --&gt;|Event| EventExec[\&quot;ExploreResolver.Resolve()&lt;br/&gt;Gold/Heal/Damage\&quot;]\n    Encounter --&gt;|Merchant| MerchantExec[\&quot;ExploreResolver.Resolve()&lt;br/&gt;Open merchant\&quot;]\n    \n    CombatExec --&gt; StartComb[\&quot;CombatUseCase.StartCombat()&lt;br/&gt;session.ActiveCombatSession = new\&quot;]\n    StartComb --&gt; ReturnDTO1[\&quot;ExploreResultDto&lt;br/&gt;StartsCombat = true&lt;br/&gt;EnemyId = xxx\&quot;]\n    \n    LootChest --&gt; GetLootTable[\&quot;LootTable.Resolve(lootTableId)&lt;br/&gt;Get table by ID\&quot;]\n    GetLootTable --&gt; RollLoot[\&quot;LootTable.Roll(_random)&lt;br/&gt;Weighted item selection\&quot;]\n    RollLoot --&gt; ApplyLoot[\&quot;ApplyLootUseCase.ApplyItem()&lt;br/&gt;Add to Inventory\&quot;]\n    \n    ApplyLoot --&gt; CheckInvFull{Inventory Full?}\n    CheckInvFull --&gt;|Yes| LootFail[\&quot;Message: &#39;Inventory full!&#39;\&quot;]\n    CheckInvFull --&gt;|No| LootSuccess[\&quot;Message: &#39;Loot obtained: ItemName&#39;&lt;br/&gt;Publish LootGranted event\&quot;]\n    \n    LootFail --&gt; ReturnDTO2[\&quot;ExploreResultDto&lt;br/&gt;Success = true\&quot;]\n    LootSuccess --&gt; ReturnDTO2\n    \n    EventExec --&gt; CheckEffect{Effect Type?}\n    CheckEffect --&gt;|Gold| ApplyGold[\&quot;Player.AddGold(amount)&lt;br/&gt;Message with gold amount\&quot;]\n    CheckEffect --&gt;|Heal| ApplyHeal[\&quot;Health.Heal(amount)&lt;br/&gt;Message with HP healed\&quot;]\n    CheckEffect --&gt;|Damage| ApplyDmg[\&quot;Health.TakeDamage(amount)&lt;br/&gt;Message with damage taken\&quot;]\n    \n    ApplyGold --&gt; ReturnDTO3[\&quot;ExploreResultDto&lt;br/&gt;Success = true\&quot;]\n    ApplyHeal --&gt; ReturnDTO3\n    ApplyDmg --&gt; ReturnDTO3\n    \n    MerchantExec --&gt; ReturnDTO4[\&quot;ExploreResultDto&lt;br/&gt;OpensMerchant = true\&quot;]\n    \n    ReturnDTO1 --&gt; ExploreEnd([Return to Gameplay])\n    ReturnDTO2 --&gt; ExploreEnd\n    ReturnDTO3 --&gt; ExploreEnd\n    ReturnDTO4 --&gt; ExploreEnd\n    End1 --&gt; ExploreEnd\n    \n    style ExploreStart fill:#87CEEB\n    style GetLootTable fill:#FFE4B5\n    style RollLoot fill:#FFE4B5\n    style ApplyLoot fill:#98FB98\n    style LootSuccess fill:#90EE90\n    style LootFail fill:#FFB6C6&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="y8j1kmBoieyWH5r7P66x-1">
