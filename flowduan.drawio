        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Start Game]) --&gt; MainMenu{Main Menu}\n    MainMenu --&gt;|New Game| StartGame[\&quot;StartGameUseCase:&lt;br/&gt;Create Player&lt;br/&gt;Initialize GameSession\&quot;]\n    MainMenu --&gt;|Load Game| LoadGame[\&quot;SaveLoadUseCase:&lt;br/&gt;Load from JSON\&quot;]\n    MainMenu --&gt;|Exit| End([Exit])\n    \n    StartGame --&gt; GameLoop[\&quot;🎮 Gameplay Loop\&quot;]\n    LoadGame --&gt; GameLoop\n    \n    GameLoop --&gt; DailyChoice{Daily Action}\n    DailyChoice --&gt;|Explore| Explore[\&quot;ExploreUseCase&lt;br/&gt;Pick Encounter\&quot;]\n    DailyChoice --&gt;|Rest| Rest[\&quot;RestUseCase&lt;br/&gt;Restore HP\&quot;]\n    DailyChoice --&gt;|Inventory| Inv[\&quot;Inventory/Equipment&lt;br/&gt;No action cost\&quot;]\n    DailyChoice --&gt;|Advance Day| AdvDay[\&quot;AdvanceDayUseCase&lt;br/&gt;Check Boss Trigger\&quot;]\n    \n    Explore --&gt; EncounterCheck{Encounter Type?}\n    EncounterCheck --&gt;|Combat| CombatLoop[\&quot;CombatUseCase&lt;br/&gt;Turn-based Battle\&quot;]\n    EncounterCheck --&gt;|Loot| ApplyLoot[\&quot;ApplyLootUseCase&lt;br/&gt;Add to Inventory\&quot;]\n    EncounterCheck --&gt;|Event| EventApply[\&quot;Apply Event Effect&lt;br/&gt;Gold/HP/Damage\&quot;]\n    EncounterCheck --&gt;|Merchant| MerchantUI[\&quot;MerchantUseCase&lt;br/&gt;Buy/Sell Items\&quot;]\n    \n    Rest --&gt; GameLoop\n    Inv --&gt; GameLoop\n    CombatLoop --&gt; CombatEnd{Combat Result?}\n    CombatEnd --&gt;|Player Dies| GameOver[\&quot;Game Over&lt;br/&gt;MetaProgression Update\&quot;]\n    CombatEnd --&gt;|Player Wins| LootApply[\&quot;ApplyLoot + Continue\&quot;]\n    CombatEnd --&gt;|Fled| GameLoop\n    \n    ApplyLoot --&gt; GameLoop\n    EventApply --&gt; GameLoop\n    MerchantUI --&gt; GameLoop\n    LootApply --&gt; GameLoop\n    \n    AdvDay --&gt; BossCheck{Is Boss Day?}\n    BossCheck --&gt;|Yes| BossUI[\&quot;Go to Boss Battle&lt;br/&gt;Cannot escape\&quot;]\n    BossCheck --&gt;|No| GameLoop\n    \n    BossUI --&gt; BossCombat[\&quot;BossBattleUseCase&lt;br/&gt;Multi-phase Combat\&quot;]\n    BossCombat --&gt; BossEnd{Boss Result?}\n    BossEnd --&gt;|Player Dies| GameOver\n    BossEnd --&gt;|Boss Defeated| BossReward[\&quot;ApplyBossRewards:&lt;br/&gt;Loot + Difficulty++&lt;br/&gt;Reset to Day 1\&quot;]\n    \n    BossReward --&gt; GameLoop\n    GameOver --&gt; Save[\&quot;Save MetaProgression\&quot;]\n    Save --&gt; MainMenu\n    \n    style Start fill:#90EE90\n    style End fill:#FFB6C6\n    style GameOver fill:#FFB6C6\n    style GameLoop fill:#87CEEB\n    style BossCombat fill:#FF8C00&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ENiQIeD4abg4W8dbPYq8-1">
