  <diagram id="nuu2n2FsjULi_H9JA-K-" name="Flow chi tiết Save/load">
    <mxGraphModel dx="1768" dy="1036" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    SaveTrigger[\&quot;User Triggers Save&lt;br/&gt;OR Auto-save on Game Over\&quot;]\n    \n    SaveTrigger --&gt; SaveRequest[\&quot;SaveLoadUseCase.Save(session)\&quot;]\n    \n    SaveRequest --&gt; SerializeGame[\&quot;Serialize GameSession to DTO:&lt;br/&gt;Player state&lt;br/&gt;CurrentDay&lt;br/&gt;Difficulty&lt;br/&gt;MetaProgression&lt;br/&gt;Inventory&lt;br/&gt;Equipment&lt;br/&gt;Health&lt;br/&gt;Stats\&quot;]\n    \n    SerializeGame --&gt; SerializePlayer[\&quot;Serialize Player:&lt;br/&gt;Name&lt;br/&gt;Health (current/max)&lt;br/&gt;Stats (ATK/DEF/CRIT)&lt;br/&gt;Gold&lt;br/&gt;Inventory items&lt;br/&gt;Equipped items\&quot;]\n    \n    SerializeGame --&gt; SerializeMeta[\&quot;Serialize MetaProgression:&lt;br/&gt;HighestDifficulty&lt;br/&gt;BossesDefeated[]&lt;br/&gt;TotalGameTime&lt;br/&gt;PlayCount\&quot;]\n    \n    SerializePlayer --&gt; JsonConvert[\&quot;JsonConvert.SerializeObject(dto)&lt;br/&gt;Convert to JSON string\&quot;]\n    SerializeMeta --&gt; JsonConvert\n    \n    JsonConvert --&gt; WriteFile[\&quot;File.WriteAllText(&lt;br/&gt;%LocalAppData%/Lunar/save.json,&lt;br/&gt;jsonString)\&quot;]\n    \n    WriteFile --&gt; SaveSuccess[\&quot;✅ Save Complete&lt;br/&gt;Message: &#39;Game saved&#39;\&quot;]\n    \n    SaveSuccess --&gt; End1([Return])\n    \n    LoadTrigger[\&quot;User Chooses: Load Game\&quot;]\n    \n    LoadTrigger --&gt; CheckFile{save.json exists?}\n    CheckFile --&gt;|No| LoadFail[\&quot;❌ No save found&lt;br/&gt;Message: &#39;No save file&#39;\&quot;]\n    CheckFile --&gt;|Yes| ReadFile[\&quot;File.ReadAllText(&lt;br/&gt;%LocalAppData%/Lunar/save.json)\&quot;]\n    \n    LoadFail --&gt; End2([Return to Menu])\n    \n    ReadFile --&gt; JsonParse[\&quot;JsonConvert.DeserializeObject(jsonString)&lt;br/&gt;Parse JSON string\&quot;]\n    \n    JsonParse --&gt; ParseError{Parse Error?}\n    ParseError --&gt;|Yes| CorruptFail[\&quot;❌ Corrupted save&lt;br/&gt;Message: &#39;Save file corrupted&#39;\&quot;]\n    ParseError --&gt;|No| ReconstructGame[\&quot;Reconstruct GameSession:&lt;br/&gt;Create Player from DTO&lt;br/&gt;Set CurrentDay&lt;br/&gt;Set Difficulty&lt;br/&gt;Set Inventory state&lt;br/&gt;Set Equipment state&lt;br/&gt;Set MetaProgression\&quot;]\n    \n    CorruptFail --&gt; End2\n    \n    ReconstructGame --&gt; ValidateState{State Valid?}\n    ValidateState --&gt;|No| StateFail[\&quot;❌ Invalid state&lt;br/&gt;Message: &#39;Save file invalid&#39;\&quot;]\n    ValidateState --&gt;|Yes| LoadSuccess[\&quot;✅ Load Complete&lt;br/&gt;Message: &#39;Game loaded&#39;\&quot;]\n    \n    StateFail --&gt; End2\n    \n    LoadSuccess --&gt; ResumeGame[\&quot;GameSession fully restored&lt;br/&gt;Ready to resume gameplay\&quot;]\n    \n    ResumeGame --&gt; End3([Return to Gameplay])\n    \n    style SaveTrigger fill:#87CEEB\n    style WriteFile fill:#FFE4B5\n    style SaveSuccess fill:#90EE90\n    style LoadTrigger fill:#87CEEB\n    style ReadFile fill:#FFE4B5\n    style ReconstructGame fill:#DDA0DD\n    style LoadSuccess fill:#90EE90\n    style LoadFail fill:#FFB6C6\n    style CorruptFail fill:#FFB6C6\n    style StateFail fill:#FFB6C6&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wTU8rBGRvC8cVC1SMUF6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="User Triggers Save&#xa;OR Auto-save on Game Over" mermaidId="n:SaveTrigger" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#87CEEB;strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="User Triggers Save&#xa;OR Auto-save on Game Over" id="wTU8rBGRvC8cVC1SMUF6-2">
          <mxCell parent="wTU8rBGRvC8cVC1SMUF6-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#87CEEB;strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
